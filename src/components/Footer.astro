---
---

<footer class="w-full border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-10 mt-auto transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Esquerda: Marca e Slogan -->
    <div class="flex flex-col items-center md:items-start gap-1">
      <div class="flex items-center gap-2">
        <img src="/favicon-96x96.png" alt="Cronômetro Digital Logo" class="w-5 h-5 object-contain" onerror="this.onerror=null; this.src='/favicon.svg';" />
        <span class="font-bold text-base tracking-tight text-[var(--text-ink)]">Cronômetro Digital</span>
        <span class="text-xs font-mono-custom text-[var(--text-mute)] bg-[var(--bg-elevated)] px-2 py-0.5 rounded border border-[var(--border-hairline)]">
          cronometrodigital.com
        </span>
      </div>
      <p class="text-xs text-[var(--text-mute)] mt-1">
        Cronômetro online de alta precisão com análise de voltas. Grátis e sem rastreamento.
      </p>
    </div>

    <!-- Direita: Links de Página e Copyright -->
    <div class="flex flex-col items-center md:items-end gap-3 text-xs text-[var(--text-body)]">
      <!-- Links de Navegação Legal e Informações -->
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-mono-custom">
        <a href="/sobre-nos" class="hover:text-[var(--led-color)] transition-colors">Sobre Nós</a>
        <span class="text-[var(--border-hairline)]">•</span>
        <a href="/politica-de-privacidade" class="hover:text-[var(--led-color)] transition-colors">Política de Privacidade</a>
        <span class="text-[var(--border-hairline)]">•</span>
        <a href="/termos-e-condicoes" class="hover:text-[var(--led-color)] transition-colors">Termos e Condições</a>
        <span class="text-[var(--border-hairline)]">•</span>
        <a href="/contato" class="hover:text-[var(--led-color)] transition-colors">Contato</a>
      </div>

      <!-- Links Rápidos -->
      <div class="flex items-center gap-3 text-[11px] text-[var(--text-mute)] font-mono-custom">
        <a href="/" class="hover:text-[var(--text-ink)] transition-colors">Cronômetro</a>
        <span class="text-[var(--border-hairline)]">•</span>
        <button id="footer-btn-shortcuts" class="hover:text-[var(--text-ink)] transition-colors cursor-pointer">Atalhos</button>
        <span class="text-[var(--border-hairline)]">•</span>
        <span>&copy; {new Date().getFullYear()} Cronômetro Digital</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const footerShortcutsBtn = document.getElementById('footer-btn-shortcuts');
  if (footerShortcutsBtn) {
    footerShortcutsBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-shortcuts-modal'));
    });
  }
</script>
