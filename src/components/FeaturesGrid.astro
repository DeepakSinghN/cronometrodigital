---
---

<section class="w-full max-w-5xl mx-auto my-16 px-4">
  <div class="flex flex-col items-center text-center mb-10">
    <span class="font-mono-custom text-xs uppercase tracking-widest text-[var(--text-mute)] bg-[var(--bg-elevated)] px-3 py-1 rounded-full border border-[var(--border-hairline)] mb-3">
      FEITO PARA PERFORMANCE
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-ink)]">
      Velocidade, Precisão e Facilidade de Uso
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-body)] max-w-xl mt-2">
      Tudo que você precisa em um cronômetro online moderno, sem anúncios intrusivos ou scripts pesados.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1: Alta Precisão -->
    <div class="geist-card p-6 flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-canvas)] border border-[var(--border-hairline)] flex items-center justify-center text-lg mb-4">
          ⚡
        </div>
        <h3 class="text-base font-semibold text-[var(--text-ink)] mb-1">Precisão Sem Deriva</h3>
        <p class="text-xs text-[var(--text-body)] leading-relaxed">
          Alimentado por timestamps de alta resolução do navegador (<code class="font-mono-custom text-[11px] bg-[var(--bg-canvas)] px-1 py-0.5 rounded">performance.now()</code>) com precisão real de 1/1000 de segundo.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-hairline)] text-[11px] font-mono-custom text-[var(--text-mute)]">
        Até 3 Casas Decimais
      </div>
    </div>

    <!-- Card 2: Atalhos de Teclado -->
    <div class="geist-card p-6 flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-canvas)] border border-[var(--border-hairline)] flex items-center justify-center text-lg mb-4">
          ⌨️
        </div>
        <h3 class="text-base font-semibold text-[var(--text-ink)] mb-1">Atalhos de Teclado</h3>
        <p class="text-xs text-[var(--text-body)] leading-relaxed">
          Controle o cronômetro com a barra de espaço para iniciar/pausar, <kbd class="px-1 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] font-mono-custom text-[10px]">L</kbd> para voltas e <kbd class="px-1 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] font-mono-custom text-[10px]">R</kbd> para resetar.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-hairline)] text-[11px] font-mono-custom text-[var(--text-mute)]">
        Acesso Completo pelo Teclado
      </div>
    </div>

    <!-- Card 3: Análise de Voltas -->
    <div class="geist-card p-6 flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-canvas)] border border-[var(--border-hairline)] flex items-center justify-center text-lg mb-4">
          📊
        </div>
        <h3 class="text-base font-semibold text-[var(--text-ink)] mb-1">Delta de Voltas & Estatísticas</h3>
        <p class="text-xs text-[var(--text-body)] leading-relaxed">
          Detecção imediata das voltas mais rápidas e lentas, cálculo de médias ao vivo e comparação de variações de tempo (+/-).
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-hairline)] text-[11px] font-mono-custom text-[var(--text-mute)]">
        Exportar CSV & Área de Transferência
      </div>
    </div>

    <!-- Card 4: Áudio e Tela Cheia -->
    <div class="geist-card p-6 flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-lg bg-[var(--bg-canvas)] border border-[var(--border-hairline)] flex items-center justify-center text-lg mb-4">
          🔊
        </div>
        <h3 class="text-base font-semibold text-[var(--text-ink)] mb-1">Áudio & Tela Cheia</h3>
        <p class="text-xs text-[var(--text-body)] leading-relaxed">
          Cliques de áudio sintetizados via Web Audio para feedback tátil e modo tela cheia imersivo, ideal para academia, esportes ou estudo.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-hairline)] text-[11px] font-mono-custom text-[var(--text-mute)]">
        Sem Arquivos de Áudio Externos
      </div>
    </div>
  </div>
</section>
