---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { 
  title = "Cronômetro Online Grátis | Cronômetro com Voltas e Milissegundos", 
  description = "Cronômetro online grátis com precisão de milissegundos. Display LED, registro de voltas, atalhos de teclado e modo tela cheia. Grátis, sem cadastro.",
  canonicalPath = "",
  noindex = false,
  schema
} = Astro.props;

// Root URL has trailing slash; subpages do not (matching trailingSlash: 'never')
const canonicalUrl = (!canonicalPath || canonicalPath === '/')
  ? 'https://cronometrodigital.com/'
  : `https://cronometrodigital.com${canonicalPath.replace(/\/+$/, '')}`;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EZRJGZLBKK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-EZRJGZLBKK');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicons & Web App Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Cronômetro Digital" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata (Portuguese) -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="author" content="Cronômetro Digital" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}
    <meta name="language" content="pt-BR" />
    
    <!-- Geo Targeting: Brazil & Portuguese-speaking countries -->
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />
    <meta name="geo.position" content="-14.235;-51.9253" />
    <meta name="ICBM" content="-14.235, -51.9253" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- hreflang: Portuguese (generic), Portuguese (BR) & Fallback -->
    <link rel="alternate" hreflang="pt" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Cronômetro Digital" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content="https://cronometrodigital.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Cronômetro Digital Online Grátis com Voltas e Milissegundos" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cronometrodigital.com/og-image.png" />
    
    <!-- WebSite & Organization Structured Data (Global) -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cronometrodigital.com/#website",
          "url": "https://cronometrodigital.com/",
          "name": "Cronômetro Digital",
          "description": "Cronômetro online grátis com precisão de milissegundos para estudo, esportes, Pomodoro, cubo mágico e muito mais.",
          "inLanguage": "pt-BR"
        },
        {
          "@type": "Organization",
          "@id": "https://cronometrodigital.com/#organization",
          "name": "Cronômetro Digital",
          "url": "https://cronometrodigital.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://cronometrodigital.com/favicon-96x96.png"
          }
        }
      ]
    }
    </script>
    
    <!-- Page-Specific Structured Data -->
    {schemaList.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    
    <!-- Inline theme script to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('cronometro_theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.style.setProperty('--led-color', '#555555');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.style.setProperty('--led-color', '#FF9500');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-[var(--bg-canvas)] text-[var(--text-ink)]">
    <slot />
  </body>
</html>
