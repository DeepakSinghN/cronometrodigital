---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contato | Cronômetro Digital — cronometrodigital.com" 
  description="Entre em contato com o Cronômetro Digital (cronometrodigital.com) para feedback, suporte ou dúvidas sobre o nosso cronômetro online."
  canonicalPath="/contato"
>
  <Navbar />

  <main class="w-full flex-1 max-w-3xl mx-auto px-4 py-12">
    <!-- Cabeçalho -->
    <div class="mb-10 text-center">
      <span class="font-mono-custom text-xs uppercase tracking-widest text-[var(--text-mute)] bg-[var(--bg-elevated)] px-3 py-1 rounded-full border border-[var(--border-hairline)] mb-3 inline-block">
        SUPORTE & FEEDBACK
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--text-ink)] mb-4">
        Fale Conosco
      </h1>
      <p class="text-sm text-[var(--text-body)] max-w-md mx-auto leading-relaxed">
        Tem perguntas, sugestões ou pedidos de recursos? Adoramos ouvir você. Preencha o formulário abaixo.
      </p>
    </div>

    <!-- Card do Formulário de Contato -->
    <div class="geist-card p-6 sm:p-10 shadow-lg">
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-ink)] mb-2">
            Seu Nome <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="contact-name" 
            name="name" 
            required 
            placeholder="João Silva"
            class="w-full bg-[var(--bg-canvas)] border border-[var(--border-hairline)] rounded-lg px-4 py-3 text-sm text-[var(--text-ink)] focus:outline-none focus:border-[var(--led-color)] transition-colors"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-ink)] mb-2">
            Endereço de E-mail <span class="text-red-500">*</span>
          </label>
          <input 
            type="email" 
            id="contact-email" 
            name="email" 
            required 
            placeholder="joao@exemplo.com"
            class="w-full bg-[var(--bg-canvas)] border border-[var(--border-hairline)] rounded-lg px-4 py-3 text-sm text-[var(--text-ink)] focus:outline-none focus:border-[var(--led-color)] transition-colors"
          />
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-ink)] mb-2">
            Assunto
          </label>
          <select 
            id="contact-subject" 
            name="subject"
            class="w-full bg-[var(--bg-canvas)] border border-[var(--border-hairline)] rounded-lg px-4 py-3 text-sm text-[var(--text-ink)] focus:outline-none focus:border-[var(--led-color)] transition-colors"
          >
            <option value="Feedback Geral">Feedback Geral</option>
            <option value="Solicitação de Recurso">Solicitação de Recurso</option>
            <option value="Relatório de Bug">Relatório de Bug</option>
            <option value="Consulta Comercial">Consulta Comercial</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-ink)] mb-2">
            Mensagem <span class="text-red-500">*</span>
          </label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Escreva sua mensagem aqui..."
            class="w-full bg-[var(--bg-canvas)] border border-[var(--border-hairline)] rounded-lg px-4 py-3 text-sm text-[var(--text-ink)] focus:outline-none focus:border-[var(--led-color)] transition-colors"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="btn-submit-contact"
          class="w-full py-3.5 rounded-lg bg-[var(--led-color)] text-black font-bold text-sm hover:opacity-90 active:scale-[0.99] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Enviar Mensagem</span>
        </button>

        <div id="contact-success-msg" class="hidden p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold text-center">
          ✅ Obrigado por entrar em contato com o Cronômetro Digital! Sua mensagem foi enviada com sucesso.
        </div>
      </form>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const contactForm = document.getElementById('contact-form');
  const successMsg = document.getElementById('contact-success-msg');

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
        contactForm.reset();
        setTimeout(() => {
          successMsg.classList.add('hidden');
        }, 5000);
      }
    });
  }
</script>
