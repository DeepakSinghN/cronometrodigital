---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const contactSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Início",
        "item": "https://cronometrodigital.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contato",
        "item": "https://cronometrodigital.com/contato"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contato | Cronômetro Digital",
    "url": "https://cronometrodigital.com/contato",
    "description": "Entre em contato com a equipe do Cronômetro Digital para dúvidas, sugestões de novos recursos, relatórios técnicos ou privacidade.",
    "inLanguage": "pt-BR",
    "mainEntity": {
      "@type": "Organization",
      "name": "Cronômetro Digital",
      "email": "lifeturningpoint007@gmail.com",
      "url": "https://cronometrodigital.com/"
    }
  }
];
---

<Layout 
  title="Contato | Cronômetro Digital — Fale Conosco" 
  description="Entre em contato diretamente com a equipe do Cronômetro Digital (lifeturningpoint007@gmail.com) para suporte, feedback, sugestões ou dúvidas sobre LGPD."
  canonicalPath="/contato"
  schema={contactSchema}
>
  <Navbar />

  <main class="w-full flex-1 max-w-3xl mx-auto px-4 py-12">
    <!-- Cabeçalho -->
    <div class="mb-10 text-center">
      <span class="font-mono-custom text-xs uppercase tracking-widest text-[var(--text-mute)] bg-[var(--bg-elevated)] px-3.5 py-1.5 rounded-full border border-[var(--border-hairline)] mb-4 inline-block">
        SUPORTE & CONTATO
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--text-ink)] mb-4">
        Fale Conosco
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-body)] max-w-lg mx-auto leading-relaxed">
        Tem alguma dúvida sobre o funcionamento do <strong>cronômetro online</strong>, sugestão de recurso ou precisa de suporte? Estamos sempre à disposição.
      </p>
    </div>

    <!-- Card de Contato Principal -->
    <div class="geist-card p-8 sm:p-10 text-center shadow-xl border border-[var(--border-hairline)] rounded-2xl bg-[var(--bg-elevated)] mb-8">
      <div class="w-16 h-16 rounded-full bg-[var(--led-color)]/10 text-[var(--led-color)] flex items-center justify-center text-3xl mx-auto mb-6">
        ✉️
      </div>

      <h2 class="text-xs uppercase tracking-wider font-semibold text-[var(--text-mute)] mb-2">
        Canal Oficial de Atendimento
      </h2>

      <!-- Box do E-mail -->
      <div class="my-4 p-4 rounded-xl bg-[var(--bg-canvas)] border border-[var(--border-hairline)] flex flex-col sm:flex-row items-center justify-between gap-3">
        <a 
          href="mailto:lifeturningpoint007@gmail.com" 
          class="font-mono-custom text-base sm:text-lg font-bold text-[var(--text-ink)] hover:text-[var(--led-color)] transition-colors break-all"
        >
          lifeturningpoint007@gmail.com
        </a>

        <button 
          id="btn-copy-email" 
          type="button" 
          class="px-4 py-2 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-hairline)] text-xs font-semibold text-[var(--text-ink)] hover:border-[var(--led-color)] transition-all cursor-pointer shrink-0 flex items-center gap-1.5"
        >
          <span id="copy-email-icon">📋</span>
          <span id="copy-email-text">Copiar E-mail</span>
        </button>
      </div>

      <!-- Botão Enviar E-mail -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="mailto:lifeturningpoint007@gmail.com" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[var(--led-color)] text-black font-bold text-sm hover:opacity-90 active:scale-[0.98] transition-all shadow-md flex items-center justify-center gap-2"
        >
          <span>Abrir aplicativo de e-mail</span>
          <span>↗</span>
        </a>
      </div>

      <div class="mt-6 pt-5 border-t border-[var(--border-hairline)] text-xs text-[var(--text-mute)] leading-relaxed">
        ⏱️ Respondemos a todas as mensagens de suporte e colaboração em até <strong>24 a 48 horas úteis</strong>.
      </div>
    </div>

    <!-- Motivos Frequentes de Contato -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="geist-card p-5 rounded-xl border border-[var(--border-hairline)]">
        <h3 class="font-bold text-sm text-[var(--text-ink)] mb-1 flex items-center gap-2">
          💡 Sugestões de Recursos
        </h3>
        <p class="text-xs text-[var(--text-mute)] leading-relaxed">
          Gostaria de ver novos recursos no cronômetro online (como novos temas, sons de alerta personalizados ou formatos de exportação)? Envie sua ideia!
        </p>
      </div>

      <div class="geist-card p-5 rounded-xl border border-[var(--border-hairline)]">
        <h3 class="font-bold text-sm text-[var(--text-ink)] mb-1 flex items-center gap-2">
          🐛 Relato de Bugs & Erros
        </h3>
        <p class="text-xs text-[var(--text-mute)] leading-relaxed">
          Encontrou algum comportamento anômalo no registro de voltas ou atalhos de teclado no seu navegador? Informe o modelo do dispositivo e navegador utilizado.
        </p>
      </div>

      <div class="geist-card p-5 rounded-xl border border-[var(--border-hairline)]">
        <h3 class="font-bold text-sm text-[var(--text-ink)] mb-1 flex items-center gap-2">
          🛡️ Dúvidas de Privacidade (LGPD)
        </h3>
        <p class="text-xs text-[var(--text-mute)] leading-relaxed">
          Para qualquer requisição de titular de dados ou esclarecimentos sobre nossa conformidade com a Lei nº 13.709/2018 (LGPD), este é o canal oficial.
        </p>
      </div>

      <div class="geist-card p-5 rounded-xl border border-[var(--border-hairline)]">
        <h3 class="font-bold text-sm text-[var(--text-ink)] mb-1 flex items-center gap-2">
          🤝 Parcerias & Divulgação
        </h3>
        <p class="text-xs text-[var(--text-mute)] leading-relaxed">
          Projetos educacionais, clubes esportivos, comunidades de speedcubing ou desenvolvedores interessados em colaborações institucionais são muito bem-vindos.
        </p>
      </div>
    </div>

    <!-- Guia Rápido -->
    <div class="geist-card p-6 rounded-xl border border-[var(--border-hairline)] text-xs text-[var(--text-body)] space-y-2">
      <h3 class="font-bold text-sm text-[var(--text-ink)]">Dicas para um suporte mais ágil:</h3>
      <p>1. Ao reportar erros, mencione se você está utilizando Chrome, Firefox, Safari ou Edge, e se é no computador ou smartphone.</p>
      <p>2. Dúvidas sobre o funcionamento básico de voltas, atalhos e Pomodoro também podem ser resolvidas diretamente na nossa seção de perguntas frequentes na <a href="/" class="text-[var(--led-color)] underline">Página Inicial</a>.</p>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const copyBtn = document.getElementById('btn-copy-email');
  const copyText = document.getElementById('copy-email-text');
  const copyIcon = document.getElementById('copy-email-icon');
  const emailStr = 'lifeturningpoint007@gmail.com';

  if (copyBtn && copyText && copyIcon) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailStr);
        copyText.textContent = 'Copiado!';
        copyIcon.textContent = '✅';
        copyBtn.classList.add('border-emerald-500', 'text-emerald-500');

        setTimeout(() => {
          copyText.textContent = 'Copiar E-mail';
          copyIcon.textContent = '📋';
          copyBtn.classList.remove('border-emerald-500', 'text-emerald-500');
        }, 3000);
      } catch (err) {
        console.error('Erro ao copiar e-mail:', err);
      }
    });
  }
</script>
