    { name: 'Carnaval (Ponto Facultativo)', date: '2027-02-09', year: 2027 },
    { name: 'Quarta-feira de Cinzas', date: '2027-02-10', year: 2027 },
    { name: 'Sexta-feira Santa', date: '2027-03-26', year: 2027 },
    { name: 'Páscoa', date: '2027-03-28', year: 2027 },
    { name: 'Tiradentes', date: '2027-04-21', year: 2027 },
    { name: 'Dia Mundial do Trabalho', date: '2027-05-01', year: 2027 },
    { name: 'Corpus Christi', date: '2027-05-27', year: 2027 },
    { name: 'Independência do Brasil', date: '2027-09-07', year: 2027 },
    { name: 'Nossa Senhora Aparecida', date: '2027-10-12', year: 2027 },
    { name: 'Dia de Finados', date: '2027-11-02', year: 2027 },
    { name: 'Proclamação da República', date: '2027-11-15', year: 2027 },
    { name: 'Dia da Consciência Negra', date: '2027-11-20', year: 2027 },
    { name: 'Natal', date: '2027-12-25', year: 2027 }
  ];

  // Dados Oficiais de Feriados Portugal (2026 & 2027)
  const feriadosPortugal = [
    // 2026
    { name: 'Ano Novo', date: '2026-01-01', year: 2026 },
    { name: 'Sexta-feira Santa', date: '2026-04-03', year: 2026 },
    { name: 'Domingo de Páscoa', date: '2026-04-05', year: 2026 },
    { name: 'Dia da Liberdade (25 de Abril)', date: '2026-04-25', year: 2026 },
    { name: 'Dia do Trabalhador', date: '2026-05-01', year: 2026 },
    { name: 'Corpo de Deus (Corpus Christi)', date: '2026-06-04', year: 2026 },
    { name: 'Dia de Portugal e de Camões', date: '2026-06-10', year: 2026 },
    { name: 'Assunção de Nossa Senhora', date: '2026-08-15', year: 2026 },
    { name: 'Implantação da República', date: '2026-10-05', year: 2026 },
    { name: 'Dia de Todos os Santos', date: '2026-11-01', year: 2026 },
    { name: 'Restauração da Independência', date: '2026-12-01', year: 2026 },
    { name: 'Imaculada Conceição', date: '2026-12-08', year: 2026 },
    { name: 'Natal', date: '2026-12-25', year: 2026 },
    // 2027
    { name: 'Ano Novo', date: '2027-01-01', year: 2027 },
    { name: 'Sexta-feira Santa', date: '2027-03-26', year: 2027 },
    { name: 'Domingo de Páscoa', date: '2027-03-28', year: 2027 },
    { name: 'Dia da Liberdade (25 de Abril)', date: '2027-04-25', year: 2027 },
    { name: 'Dia do Trabalhador', date: '2027-05-01', year: 2027 },
    { name: 'Corpo de Deus (Corpus Christi)', date: '2027-05-27', year: 2027 },
    { name: 'Dia de Portugal e de Camões', date: '2027-06-10', year: 2027 },
    { name: 'Assunção de Nossa Senhora', date: '2027-08-15', year: 2027 },
    { name: 'Implantação da República', date: '2027-10-05', year: 2027 },
    { name: 'Dia de Todos os Santos', date: '2027-11-01', year: 2027 },
    { name: 'Restauração da Independência', date: '2027-12-01', year: 2027 },
    { name: 'Imaculada Conceição', date: '2027-12-08', year: 2027 },
    { name: 'Natal', date: '2027-12-25', year: 2027 }
  ];

  function formatBRDate(isoDateStr) {
    const parts = isoDateStr.split('-');
    return `${parts[2]}/${parts[1]}/${parts[0]}`;
  }

  function getDaysRemaining(targetDateStr) {
    const now = new Date();
    // Normalize to local midnight
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const [y, m, d] = targetDateStr.split('-').map(Number);
    const target = new Date(y, m - 1, d);
    const diffMs = target.getTime() - today.getTime();
    return Math.round(diffMs / (1000 * 60 * 60 * 24));
  }

  let selectedYearFilter = 'all';

  function renderTable(tbodyId, list) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;

    let filtered = list;
    if (selectedYearFilter !== 'all') {
      const yr = parseInt(selectedYearFilter, 10);
      filtered = list.filter((item) => item.year === yr);
    }

    // Sort chronologically
    filtered.sort((a, b) => new Date(a.date) - new Date(b.date));

    tbody.innerHTML = '';
    filtered.forEach((item) => {
      const days = getDaysRemaining(item.date);
      const row = document.createElement('tr');
      row.className = 'hover:bg-[var(--bg-canvas)] transition-colors';

      let daysLabel = '';
      let daysClass = 'text-[var(--text-mute)]';

      if (days < 0) {
        daysLabel = 'Passou';
        daysClass = 'text-[var(--text-mute)] opacity-50 line-through';
      } else if (days === 0) {
        daysLabel = 'Hoje! 🎉';
        daysClass = 'text-emerald-400 font-bold';
      } else if (days === 1) {
        daysLabel = 'Amanhã';
        daysClass = 'text-[var(--led-color)] font-bold';
      } else {
        daysLabel = `${days} dias`;
        if (days <= 30) {
          daysClass = 'text-[var(--led-color)] font-semibold';
        }
      }

      row.innerHTML = `
        <td class="py-2.5 px-2 font-medium text-[var(--text-ink)]">${item.name}</td>
        <td class="py-2.5 px-2 text-[var(--text-mute)]">${formatBRDate(item.date)}</td>
        <td class="py-2.5 px-2 text-right ${daysClass}">${daysLabel}</td>
      `;
      tbody.appendChild(row);
    });
  }

  // Atualiza Banner do Próximo Feriado no Brasil com contagem regressiva em tempo real
  function updateNextHolidayCountdown() {
    const now = new Date();
    // Acha o primeiro feriado do Brasil cuja data seja >= hoje
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const upcoming = feriadosBrasil
      .filter((item) => {
        const [y, m, d] = item.date.split('-').map(Number);
        return new Date(y, m - 1, d) >= today;
      })
      .sort((a, b) => new Date(a.date) - new Date(b.date));

    if (upcoming.length === 0) return;
    const nextHoli = upcoming[0];

    const nameEl = document.getElementById('next-holiday-name');
    const dateEl = document.getElementById('next-holiday-date');
    if (nameEl) nameEl.textContent = nextHoli.name;
    if (dateEl) dateEl.textContent = `Data: ${formatBRDate(nextHoli.date)} • Feriado Nacional`;

    const [y, m, d] = nextHoli.date.split('-').map(Number);
    const targetMidnight = new Date(y, m - 1, d, 0, 0, 0);

    function tick() {
      const current = new Date();
      const diff = targetMidnight.getTime() - current.getTime();

      const daysEl = document.getElementById('next-cd-days');
      const hoursEl = document.getElementById('next-cd-hours');
      const minsEl = document.getElementById('next-cd-mins');
      const secsEl = document.getElementById('next-cd-secs');

      if (diff <= 0) {
        if (daysEl) daysEl.textContent = '00';
        if (hoursEl) hoursEl.textContent = '00';
        if (minsEl) minsEl.textContent = '00';
        if (secsEl) secsEl.textContent = '00';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((diff / (1000 * 60)) % 60);
      const secs = Math.floor((diff / 1000) % 60);

      if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
    }

    tick();
    setInterval(tick, 1000);
  }

  function initFeriados() {
    renderTable('table-feriados-brasil', feriadosBrasil);
    renderTable('table-feriados-portugal', feriadosPortugal);
    updateNextHolidayCountdown();

    // Filtros de ano
    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-[var(--led-color)]', 'text-black');
          b.classList.add('bg-[var(--bg-elevated)]', 'text-[var(--text-body)]', 'border');
        });
        btn.classList.add('bg-[var(--led-color)]', 'text-black');
        btn.classList.remove('bg-[var(--bg-elevated)]', 'text-[var(--text-body)]', 'border');

        selectedYearFilter = btn.getAttribute('data-year');
        renderTable('table-feriados-brasil', feriadosBrasil);
        renderTable('table-feriados-portugal', feriadosPortugal);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeriados);
  } else {
    initFeriados();
  }
</script>
