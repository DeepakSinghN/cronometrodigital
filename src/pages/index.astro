---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Stopwatch from '../components/Stopwatch.astro';
import LapTable from '../components/LapTable.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import SeoContent from '../components/SeoContent.astro';
import Footer from '../components/Footer.astro';
import ShortcutsModal from '../components/ShortcutsModal.astro';
import SettingsModal from '../components/SettingsModal.astro';

const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cronômetro Digital",
    "url": "https://cronometrodigital.com/",
    "description": "Cronômetro online grátis com precisão de milissegundos para estudo, esportes, Pomodoro, cubo mágico e muito mais.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "inLanguage": "pt-BR",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "BRL"
    },
    "featureList": [
      "Cronômetro online com milissegundos",
      "Registro de voltas",
      "Modo tela cheia",
      "Cronômetro de estudo Pomodoro",
      "Cronômetro regressivo online",
      "Exportar dados em CSV"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "O cronômetro online é completamente gratuito?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! O Cronômetro Digital é 100% gratuito, sem necessidade de cadastro, sem taxas de assinatura e sem anúncios intrusivos. Use o cronômetro online diretamente no navegador, a qualquer momento."
        }
      },
      {
        "@type": "Question",
        "name": "O cronômetro continua funcionando se eu trocar de aba?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! O motor do cronômetro calcula o tempo decorrido com base em timestamps do relógio do sistema (performance.now()), garantindo zero perda de precisão mesmo que a aba esteja em segundo plano ou minimizada."
        }
      },
      {
        "@type": "Question",
        "name": "Como exportar o histórico de voltas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Clique no botão Exportar CSV para baixar uma planilha com todos os números de volta, durações e tempos totais, ou use Copiar Voltas para colar o texto formatado rapidamente."
        }
      },
      {
        "@type": "Question",
        "name": "Como usar o cronômetro de estudo com a técnica Pomodoro?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Inicie o cronômetro de estudo, estude por 25 minutos, depois pressione L para registrar a volta (seu intervalo de estudo). Faça uma pausa de 5 minutos e repita. O cronômetro Pomodoro online é perfeito para rastrear seus ciclos de produtividade."
        }
      },
      {
        "@type": "Question",
        "name": "O cronômetro funciona no celular?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! O cronômetro digital é totalmente responsivo e funciona perfeitamente em smartphones Android e iPhone, além de tablets e computadores com qualquer navegador moderno."
        }
      }
    ]
  }
];
---

<Layout 
  title="Cronometro Online Grátis | Cronômetro Digital com Voltas e Milissegundos" 
  description="Cronometro online grátis com precisão de milissegundos. Cronômetro digital com display LED, voltas, atalhos de teclado e modo tela cheia. Ideal para estudo, esportes, cubo mágico e Pomodoro."
  canonicalPath="/"
  schema={homeSchema}
>
  <div class="min-h-screen flex flex-col w-full bg-[var(--bg-canvas)]">
    <!-- Cabeçalho de Navegação -->
    <Navbar />

    <!-- Container Principal -->
    <main class="flex-1 flex flex-col items-center px-3 sm:px-6">
      <!-- Visible Sleek H1 SEO Heading -->
      <div class="text-center pt-6 pb-2 select-none max-w-2xl px-2">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-ink)]">
          Cronômetro Online Grátis
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-mute)] mt-1.5 font-medium leading-relaxed">
          Cronômetro digital com voltas, precisão de milissegundos e atalhos de teclado para estudo, esportes e cubo mágico
        </p>
      </div>

      <!-- Cronômetro Digital Central -->
      <Stopwatch />

      <!-- Tabela de Voltas -->
      <LapTable />

      <!-- Grade de Recursos -->
      <FeaturesGrid />

      <!-- Conteúdo SEO e Guia -->
      <SeoContent />
    </main>

    <!-- Rodapé -->
    <Footer />
  </div>

  <!-- Modais -->
  <ShortcutsModal />
  <SettingsModal />
</Layout>
